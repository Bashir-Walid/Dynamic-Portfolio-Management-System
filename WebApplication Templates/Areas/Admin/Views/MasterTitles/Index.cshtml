@model WebApplication_Templates.ViewModels.MasterTitlesFullViewModels

@{
    ViewData["Title"] = "Index";
}

<div class="card">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="card-title mb-0">Titles</h4>
        </div>

        <div class="card border mb-4">
            <div class="card-body">

                <h5 class="card-title mb-4">Edit Title</h5>

                <div class="row">

                    <div class="col-md-6">

                        <form asp-action="CreateOrUpdate" method="post">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <input type="hidden" asp-for="Id" />

                            <div class="form-group mb-3">

                                <label class="control-label">Keyword</label>

                                <input type="text"
                                       id="Keyword"
                                       class="form-control"
                                       readonly />

                            </div>

                            <div class="form-group mb-3">

                                <label asp-for="Title" class="control-label"></label>

                                <input asp-for="Title" class="form-control" />

                                <span asp-validation-for="Title" class="text-danger"></span>

                            </div>

                            <div class="form-group">

                                <input type="submit"
                                       value="Save"
                                       class="btn btn-primary" />

                                <input type="reset"
                                       value="Clear"
                                       class="btn btn-warning" />

                            </div>

                        </form>

                    </div>

                </div>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Title</th>

                        <th>Keyword</th>

                        <th>Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.list)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.Title)
                            </td>

                            <td>
                                <span class="badge bg-info">
                                    @Html.DisplayFor(modelItem => item.Keyword)
                                </span>
                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Deactive
                                    </span>
                                }

                            </td>

                            <td style="min-width:170px;">

                                <a class="btn btn-outline-warning btn-sm btnEdit"
                                       data-id="@item.Id"
                                       data-title="@item.Title"
                                       data-keyword="@item.Keyword">

                                    Edit

                                </a>

                                <form asp-action="ChangeStatus"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    @if (item.IsActive)
                                    {
                                        <a class="btn btn-success btn-sm btnStatus">
                                            Active
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-danger btn-sm btnStatus">
                                            Deactive
                                        </a>
                                    }

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        $(document).ready(function () {

        $(".btnEdit").click(function () {

        var Id = $(this).data('id');

        var Title = $(this).data('title');

        var Keyword = $(this).data('keyword');

        $("#Id").val(Id);

        $("#Title").val(Title);

        $("#Keyword").val(Keyword);

        });


        $(".btnStatus").click(function () {

        var form = $(this).closest("form");

        Swal.fire({

        title: "Are you sure?",

        text: "Do you want to change status?",

        icon: "warning",

        showCancelButton: true,

        confirmButtonColor: "#3085d6",

        cancelButtonColor: "#d33",

        confirmButtonText: "Yes"

        }).then((result) => {

        if (result.isConfirmed)
        {
        form.submit();
        }

        });

        });

        });

    </script>
}