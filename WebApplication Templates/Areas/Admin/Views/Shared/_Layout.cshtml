@using WebApplication_Templates.ViewModels

<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>Dashboard | Upcube - Admin & Dashboard Template</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta content="Premium Multipurpose Admin & Dashboard Template" name="description" />
    <meta content="Themesdesign" name="author" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="~/AdminTemplate/assets/images/favicon.ico">

    <!-- DataTables -->
    <link href="~/AdminTemplate/assets/libs/datatables.net-bs4/css/dataTables.bootstrap4.min.css" rel="stylesheet" type="text/css" />
    <link href="~/AdminTemplate/assets/libs/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css" rel="stylesheet" type="text/css" />

    <!-- Bootstrap Css -->
    <link href="~/AdminTemplate/assets/css/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" type="text/css" />
    <!-- Icons Css -->
    <link href="~/AdminTemplate/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <!-- App Css-->
    <link href="~/AdminTemplate/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" />
</head>

<body data-topbar="dark">

    <!-- Begin page -->
    <div id="layout-wrapper">

        <header id="page-topbar">
            <div class="navbar-header">
                <div class="d-flex">
                    <!-- LOGO -->
                    <div class="navbar-brand-box">
                        <a asp-action="Index" asp-controller="Home" asp-area="Admin" class="logo logo-dark">
                            <span class="logo-sm">
                                <img src="~/AdminTemplate/assets/images/logo-sm.png" alt="logo-sm" height="22">
                            </span>
                            <span class="logo-lg">
                                <img src="~/AdminTemplate/assets/images/logo-dark.png" alt="logo-dark" height="20">
                            </span>
                        </a>

                        <a asp-action="Index" asp-controller="Home" asp-area="Admin" class="logo logo-light">
                            <span class="logo-sm">
                                <img src="~/AdminTemplate/assets/images/logo-sm.png" alt="logo-sm-light" height="22">
                            </span>
                            <span class="logo-lg">
                                <img src="~/AdminTemplate/assets/images/logo-light.png" alt="logo-light" height="20">
                            </span>
                        </a>
                    </div>

                    <button type="button" class="btn btn-sm px-3 font-size-24 header-item waves-effect" id="vertical-menu-btn">
                        <i class="ri-menu-2-line align-middle"></i>
                    </button>
                </div>

                <div class="d-flex">

                    <div class="dropdown d-inline-block d-lg-none ms-2">
                        <button type="button" class="btn header-item noti-icon waves-effect" id="page-header-search-dropdown"
                                data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="ri-search-line"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end p-0"
                             aria-labelledby="page-header-search-dropdown">
                            <form class="p-3">
                                <div class="mb-3 m-0">
                                    <div class="input-group">
                                        <input type="text" class="form-control" placeholder="Search ...">
                                        <div class="input-group-append">
                                            <button class="btn btn-primary" type="submit"><i class="ri-search-line"></i></button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="dropdown d-inline-block user-dropdown">
                        <button type="button" class="btn header-item waves-effect" id="page-header-user-dropdown"
                                data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">

                            <!-- استدعاء صورة الهيدر الافتراضية من قاعدة البيانات عبر المكون -->
                            @await Component.InvokeAsync("UserImage", new { cssClass = "rounded-circle header-profile-user" })

                            <span class="d-none d-xl-inline-block ms-1">@await Component.InvokeAsync("UserInfo")</span>
                            <i class="mdi mdi-chevron-down d-none d-xl-inline-block"></i>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a class="dropdown-item text-danger btnLogout" href="#"><i class="ri-shut-down-line align-middle me-1 text-danger"></i> Logout</a>
                        </div>
                    </div>

                    <div class="dropdown d-inline-block">
                        <button type="button" class="btn header-item noti-icon right-bar-toggle waves-effect">
                            <i class="ri-settings-2-line"></i>
                        </button>
                    </div>

                </div>
            </div>
        </header>

        <!-- ========== Left Sidebar Start ========== -->
        <div class="vertical-menu">

            <div data-simplebar class="h-100">

                <!-- User details -->
                <div class="user-profile text-center mt-3">
                    <div>
                        <!-- استدعاء صورة القائمة الجانبية الافتراضية من قاعدة البيانات عبر المكون -->
                        @await Component.InvokeAsync("UserImage", new { cssClass = "avatar-md rounded-circle" })
                    </div>
                    <div class="mt-3">
                        <h4 class="font-size-16 mb-1">@await Component.InvokeAsync("UserInfo")</h4>
                        <span class="text-muted"><i class="ri-record-circle-line align-middle font-size-14 text-success"></i> Online</span>
                    </div>
                </div>

                <!--- Sidemenu -->
                <div id="sidebar-menu">
                    <ul class="metismenu list-unstyled" id="side-menu">
                        <li class="menu-title">Menu</li>

                        <li>
                            <a asp-action="Index" asp-controller="Home" asp-area="Admin" class="waves-effect">
                                <i class="ri-dashboard-line"></i>
                                <span>Dashboard</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterAbout" asp-area="Admin" class="waves-effect">
                                <i class="ri-information-line"></i>
                                <span>About</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterPositions" asp-area="Admin" class="waves-effect">
                                <i class="ri-briefcase-line"></i>
                                <span>Positions</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterSocialMedia" asp-area="Admin" class="waves-effect">
                                <i class="ri-share-line"></i>
                                <span>SocialMedia</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterTitles" asp-area="Admin" class="waves-effect">
                                <i class="ri-heading"></i>
                                <span>Titles</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterServices" asp-area="Admin" class="waves-effect">
                                <i class="ri-customer-service-2-line"></i>
                                <span>Services</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterTestimonials" asp-area="Admin" class="waves-effect">
                                <i class="ri-chat-quote-line"></i>
                                <span>Testimonials</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterClients" asp-area="Admin" class="waves-effect">
                                <i class="ri-group-line"></i>
                                <span>Clients</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterPlans" asp-area="Admin" class="waves-effect">
                                <i class="ri-price-tag-3-line"></i>
                                <span>Plans</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterPlanItems" asp-area="Admin" class="waves-effect">
                                <i class="ri-list-check-2"></i>
                                <span>PlanItems</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterFacts" asp-area="Admin" class="waves-effect">
                                <i class="ri-bar-chart-box-line"></i>
                                <span>Facts</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterEducation" asp-area="Admin" class="waves-effect">
                                <i class="ri-book-open-line"></i>
                                <span>Education</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterExperience" asp-area="Admin" class="waves-effect">
                                <i class="ri-history-line"></i>
                                <span>Experience</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterSkills" asp-area="Admin" class="waves-effect">
                                <i class="ri-tools-line"></i>
                                <span>Skills</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterCertificates" asp-area="Admin" class="waves-effect">
                                <i class="ri-award-line"></i>
                                <span>Certificates</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterCategory" asp-area="Admin" class="waves-effect">
                                <i class="ri-layout-grid-line"></i>
                                <span>Category</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterPortfolio" asp-area="Admin" class="waves-effect">
                                <i class="ri-image-line"></i>
                                <span>Portfolio</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterContactUs" asp-area="Admin" class="waves-effect">
                                <i class="ri-contacts-book-2-line"></i>
                                <span>ContactUs</span>
                            </a>
                        </li>

                        <li>
                            <a asp-action="Index" asp-controller="MasterTransactionContactUs" asp-area="Admin" class="waves-effect">
                                <i class="ri-message-2-line"></i>
                                <span>TransactionContactUs</span>
                            </a>
                        </li>
                    </ul>
                </div>
                <!-- Sidebar -->
            </div>
        </div>
        <!-- Left Sidebar End -->
        <!-- ============================================================== -->
        <!-- Start right Content here -->
        <!-- ============================================================== -->
        <div class="main-content">

            <div class="page-content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
            <!-- End Page-content -->

            <footer class="footer">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6">
                            <script>document.write(new Date().getFullYear())</script> © Upcube.
                        </div>

                        <div class="col-sm-6">
                            <div class="text-sm-end d-none d-sm-block">
                                <i class="mdi mdi-heart text-danger"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>

        </div>
        <!-- end main content-->

    </div>
    <!-- END layout-wrapper -->

    <form asp-action="Logout" asp-controller="Account"
          asp-area="Admin"
          method="post"
          id="frmLogout">
    </form>

    <!-- Right Sidebar -->
    <div class="right-bar">
        <div data-simplebar class="h-100">

            <div class="rightbar-title d-flex align-items-center px-3 py-4">
                <h5 class="m-0 me-2">Settings</h5>

                <a href="javascript:void(0);" class="right-bar-toggle ms-auto">
                    <i class="mdi mdi-close noti-icon"></i>
                </a>
            </div>

            <hr class="mt-0" />

            <h6 class="text-center mb-0">Choose Layouts</h6>

            <div class="p-4">

                <div class="mb-2">
                    <img src="~/AdminTemplate/assets/images/layouts/layout-1.jpg"
                         class="img-fluid img-thumbnail"
                         alt="layout-1">
                </div>

                <div class="form-check form-switch mb-3">
                    <input class="form-check-input theme-choice"
                           type="checkbox"
                           id="light-mode-switch"
                           checked>

                    <label class="form-check-label"
                           for="light-mode-switch">
                        Light Mode
                    </label>
                </div>

                <div class="mb-2">
                    <img src="~/AdminTemplate/assets/images/layouts/layout-2.jpg"
                         class="img-fluid img-thumbnail"
                         alt="layout-2">
                </div>

                <div class="form-check form-switch mb-3">

                    <input class="form-check-input theme-choice"
                           type="checkbox"
                           id="dark-mode-switch"
                           data-bsStyle="~/AdminTemplate/assets/css/bootstrap.min.css"
                           data-appStyle="~/AdminTemplate/assets/css/app.min.css">

                    <label class="form-check-label"
                           for="dark-mode-switch">
                        Dark Mode
                    </label>

                </div>

                <div class="mb-2">
                    <img src="~/AdminTemplate/assets/images/layouts/layout-3.jpg"
                         class="img-fluid img-thumbnail"
                         alt="layout-3">
                </div>

                <div class="form-check form-switch mb-5">

                    <input class="form-check-input theme-choice"
                           type="checkbox"
                           id="rtl-mode-switch"
                           data-appStyle="~/AdminTemplate/assets/css/app-rtl.min.css">

                    <label class="form-check-label"
                           for="rtl-mode-switch">
                        RTL Mode
                    </label>

                </div>

            </div>
        </div>
    </div>
    <!-- /Right-bar -->

    <div class="rightbar-overlay"></div>

    <!-- JAVASCRIPT -->
    <script src="~/AdminTemplate/assets/libs/jquery/jquery.min.js"></script>
    <script src="~/AdminTemplate/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>

    <script src="~/AdminTemplate/assets/libs/metismenu/metisMenu.min.js"></script>

    <script src="~/AdminTemplate/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/AdminTemplate/assets/libs/node-waves/waves.min.js"></script>

    <!-- Required datatable js -->
    <script src="~/AdminTemplate/assets/libs/datatables.net/js/jquery.dataTables.min.js"></script>
    <script src="~/AdminTemplate/assets/libs/datatables.net-bs4/js/dataTables.bootstrap4.min.js"></script>

    <!-- Responsive examples -->
    <script src="~/AdminTemplate/assets/libs/datatables.net-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/AdminTemplate/assets/libs/datatables.net-responsive-bs4/js/responsive.bootstrap4.min.js"></script>

    <!-- App js -->
    <script src="~/AdminTemplate/assets/js/app.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function () {
        $(".btnLogout").click(function (e) {
        e.preventDefault();
        $("#frmLogout").submit();
        });
        });
    </script>

</body>
</html>