@model WebApplication_Templates.ViewModels.MasterSkillsFullViewModels

@{
    ViewData["Title"] = "Index";
}

<div class="card">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="card-title mb-0">Skills</h4>
        </div>

        <div class="card border mb-4">
            <div class="card-body">

                <h5 class="card-title mb-4">Add / Edit Skill</h5>

                <div class="row">
                    <div class="col-md-6">

                        <form asp-action="CreateOrUpdate"
                              method="post"
                              enctype="multipart/form-data">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <input type="hidden" asp-for="Id" />

                            <div class="form-group mb-3">

                                <label asp-for="Name" class="control-label"></label>

                                <input asp-for="Name" class="form-control" />

                                <span asp-validation-for="Name" class="text-danger"></span>

                            </div>

                            <div class="form-group mb-3">

                                <label asp-for="Percentage" class="control-label"></label>

                                <input asp-for="Percentage" class="form-control" />

                                <span asp-validation-for="Percentage" class="text-danger"></span>

                            </div>

                            <div class="form-group form-check mb-3">

                                <label class="form-check-label">

                                    <input class="form-check-input"
                                           asp-for="IsActive" />

                                    @Html.DisplayNameFor(model => model.IsActive)

                                </label>

                            </div>

                            <div class="form-group form-check mb-3">

                                <label class="form-check-label">

                                    <input class="form-check-input"
                                           asp-for="IsSoftSkill" />

                                    @Html.DisplayNameFor(model => model.IsSoftSkill)

                                </label>

                            </div>

                            <div class="form-group form-check mb-3">

                                <label class="form-check-label">

                                    <input class="form-check-input"
                                           asp-for="IsKnowledge" />

                                    @Html.DisplayNameFor(model => model.IsKnowledge)

                                </label>

                            </div>

                            <div class="form-group">

                                <input type="submit"
                                       value="Save"
                                       class="btn btn-primary" />

                                <input type="reset"
                                       value="Clear"
                                       class="btn btn-warning" />

                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Name</th>

                        <th>Percentage</th>

                        <th>Soft Skill</th>

                        <th>Knowledge</th>

                        <th>Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.list)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Percentage)%
                            </td>

                            <td>

                                @if (item.IsSoftSkill)
                                {
                                    <span class="badge bg-info">
                                        Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        No
                                    </span>
                                }

                            </td>

                            <td>

                                @if (item.IsKnowledge)
                                {
                                    <span class="badge bg-primary">
                                        Yes
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        No
                                    </span>
                                }

                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Deactive
                                    </span>
                                }

                            </td>

                            <td style="min-width:230px;">

                                <a class="btn btn-outline-warning btn-sm btnEdit"
                                       data-id="@item.Id"
                                       data-name="@item.Name"
                                       data-percentage="@item.Percentage"
                                       data-is-soft-skill="@item.IsSoftSkill"
                                       data-is-knowledge="@item.IsKnowledge"
                                       data-is-active="@item.IsActive">

                                    Edit

                                </a>

                                <form asp-action="ChangeStatus"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    @if (item.IsActive)
                                    {
                                        <a class="btn btn-success btn-sm btnStatus">
                                            Active
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-danger btn-sm btnStatus">
                                            Deactive
                                        </a>
                                    }

                                </form>

                                <form asp-action="Delete"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           asp-for="DeleteId"
                                           value="@item.Id" />

                                    <a class="btn btn-danger btn-sm btnDelete">
                                        Delete
                                    </a>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        $(document).ready(function () {

        $(".btnEdit").click(function () {

        var Id = $(this).data('id');
        var Name = $(this).data('name');
        var Percentage = $(this).data('percentage');
        var IsSoftSkill = $(this).data("is-soft-skill");
        var IsKnowledge = $(this).data("is-knowledge");
        var IsActive = $(this).data("is-active");

        $("#Id").val(Id);
        $("#Name").val(Name);
        $("#Percentage").val(Percentage);

        $("#IsActive").prop(
        'checked',
        IsActive === true ||
        IsActive === 'True' ||
        IsActive === 'true'
        );

        $("#IsSoftSkill").prop(
        'checked',
        IsSoftSkill === true ||
        IsSoftSkill === 'True' ||
        IsSoftSkill === 'true'
        );

        $("#IsKnowledge").prop(
        'checked',
        IsKnowledge === true ||
        IsKnowledge === 'True' ||
        IsKnowledge === 'true'
        );

        });

        $(".btnStatus").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "Do you want to change status?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });

        $(".btnDelete").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });

        });

    </script>
}