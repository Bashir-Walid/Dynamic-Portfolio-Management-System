@model WebApplication_Templates.ViewModels.MasterPlansFullViewModels

@{
    ViewData["Title"] = "Index";
}

<div class="card">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="card-title mb-0">Plans</h4>
        </div>

        <div class="card border mb-4">
            <div class="card-body">

                <h5 class="card-title mb-4">Add / Edit Plan</h5>

                <div class="row">

                    <div class="col-md-6">

                        <form asp-action="CreateOrUpdate"
                              method="post"
                              enctype="multipart/form-data">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <input type="hidden" asp-for="Id" />

                            <div class="form-group mb-3">
                                <label asp-for="Name" class="control-label"></label>
                                <input asp-for="Name" class="form-control" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Price" class="control-label"></label>
                                <input asp-for="Price" class="form-control" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="PricePeriod" class="control-label"></label>
                                <input asp-for="PricePeriod" class="form-control" />
                                <span asp-validation-for="PricePeriod" class="text-danger"></span>
                            </div>

                            <div class="form-group form-check mb-3">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="IsActive" />
                                    @Html.DisplayNameFor(model => model.IsActive)
                                </label>
                            </div>

                            <div class="form-group form-check mb-3">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="IsSuggested" />
                                    @Html.DisplayNameFor(model => model.IsSuggested)
                                </label>
                            </div>

                            <div class="form-group">
                                <input type="submit" value="Save" class="btn btn-primary" />
                                <input type="reset" value="Clear" class="btn btn-warning" />
                            </div>

                        </form>

                    </div>

                </div>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">

                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Price Period</th>
                        <th>Status</th>
                        <th>Suggested</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.list)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Price)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.PricePeriod)
                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Deactive
                                    </span>
                                }

                            </td>

                            <td>

                                @if (item.IsSuggested)
                                {
                                    <span class="badge bg-primary">
                                        Suggested
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Not Suggested
                                    </span>
                                }

                            </td>

                            <td style="min-width:320px;">

                                <a class="btn btn-outline-warning btn-sm btnEdit"
                                       data-id="@item.Id"
                                       data-name="@item.Name"
                                       data-priceperiod="@item.PricePeriod"
                                       data-price="@item.Price"
                                       data-isactive="@item.IsActive"
                                       data-issuggested="@item.IsSuggested">

                                    Edit

                                </a>

                                <form asp-action="ChangeStatus"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    @if (item.IsActive)
                                    {
                                        <a class="btn btn-success btn-sm btnStatus">
                                            Active
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-danger btn-sm btnStatus">
                                            Deactive
                                        </a>
                                    }

                                </form>

                                <form asp-action="ChangeSuggested"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    @if (item.IsSuggested)
                                    {
                                        <a class="btn btn-primary btn-sm btnSuggested">
                                            Suggested
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-secondary btn-sm btnSuggested">
                                            Not Suggested
                                        </a>
                                    }

                                </form>

                                <form asp-action="Delete"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           asp-for="DeleteId"
                                           value="@item.Id" />

                                    <a class="btn btn-danger btn-sm btnDelete">
                                        Delete
                                    </a>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        $(document).ready(function () {

        $(".btnEdit").click(function () {

        var Id = $(this).data('id');
        var Name = $(this).data('name');
        var PricePeriod = $(this).data('priceperiod');
        var Price = $(this).data('price');
        var IsActive = $(this).data('isactive');
        var IsSuggested = $(this).data('issuggested');

        $("#Id").val(Id);
        $("#Name").val(Name);
        $("#Price").val(Price);
        $("#PricePeriod").val(PricePeriod);

        $("#IsActive").prop(
        'checked',
        IsActive === true ||
        IsActive === 'True' ||
        IsActive === 'true'
        );

        $("#IsSuggested").prop(
        'checked',
        IsSuggested === true ||
        IsSuggested === 'True' ||
        IsSuggested === 'true'
        );

        });

        $(".btnStatus").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "Do you want to change status?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });

        $(".btnSuggested").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "Do you want to change Suggested status?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });

        $(".btnDelete").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });

        });

    </script>
}