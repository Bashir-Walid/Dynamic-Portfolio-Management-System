@model WebApplication_Templates.ViewModels.MasterEducationFullViewModels

@{
    ViewData["Title"] = "Index";
}

<div class="card">
    <div class="card-body">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="card-title mb-0">Education</h4>
        </div>

        <div class="card border mb-4">
            <div class="card-body">

                <h5 class="card-title mb-4">Add / Edit Education</h5>

                <div class="row">

                    <div class="col-md-6">

                        <form asp-action="CreateOrUpdate"
                              method="post"
                              enctype="multipart/form-data">

                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                            <input type="hidden" asp-for="Id" />

                            <div class="form-group mb-3">

                                <label asp-for="Year" class="control-label"></label>

                                <input asp-for="Year" class="form-control" />

                                <span asp-validation-for="Year" class="text-danger"></span>

                            </div>

                            <div class="form-group mb-3">

                                <label asp-for="University" class="control-label"></label>

                                <input asp-for="University" class="form-control" />

                                <span asp-validation-for="University" class="text-danger"></span>

                            </div>

                            <div class="form-group mb-3">

                                <label asp-for="Title" class="control-label"></label>

                                <input asp-for="Title" class="form-control" />

                                <span asp-validation-for="Title" class="text-danger"></span>

                            </div>

                            <div class="form-group mb-3">

                                <label asp-for="Desc" class="control-label"></label>

                                <input asp-for="Desc" class="form-control" />

                                <span asp-validation-for="Desc" class="text-danger"></span>

                            </div>

                            <div class="form-group form-check mb-3">

                                <label class="form-check-label">

                                    <input class="form-check-input"
                                           asp-for="IsActive" />

                                    @Html.DisplayNameFor(model => model.IsActive)

                                </label>

                            </div>

                            <div class="form-group">

                                <input type="submit"
                                       value="Save"
                                       class="btn btn-primary" />

                                <input type="reset"
                                       value="Clear"
                                       class="btn btn-warning" />

                            </div>

                        </form>

                    </div>

                </div>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Title</th>

                        <th>Description</th>

                        <th>Year</th>

                        <th>University</th>

                        <th>Status</th>

                        <th>Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.list)
                    {
                        <tr>

                            <td>
                                @Html.DisplayFor(modelItem => item.Title)
                            </td>

                            <td style="min-width:250px;">
                                @Html.DisplayFor(modelItem => item.Desc)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.Year)
                            </td>

                            <td>
                                @Html.DisplayFor(modelItem => item.University)
                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Deactive
                                    </span>
                                }

                            </td>

                            <td style="min-width:230px;">

                                <input type="button"
                                       value="Edit"
                                       class="btn btn-outline-warning btn-sm btnEdit"
                                       data-id="@item.Id"
                                       data-desc="@item.Desc"
                                       data-year="@item.Year"
                                       data-university="@item.University"
                                       data-title="@item.Title"
                                       data-isactive="@item.IsActive" />

                                <form asp-action="ChangeStatus"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    @if (item.IsActive)
                                    {
                                        <a class="btn btn-success btn-sm btnStatus">
                                            Active
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-danger btn-sm btnStatus">
                                            Deactive
                                        </a>
                                    }

                                </form>

                                <form asp-action="Delete"
                                      method="post"
                                      style="display:inline;">

                                    <input type="hidden"
                                           asp-for="DeleteId"
                                           value="@item.Id" />

                                    <a class="btn btn-danger btn-sm btnDelete">
                                        Delete
                                    </a>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>

        $(document).ready(function () {

        $(".btnEdit").click(function () {

        var Id = $(this).data('id');
        var University = $(this).data('university');
        var Desc = $(this).data('desc');
        var IsActive = $(this).data('isactive');
        var Title = $(this).data('title');
        var Year = $(this).data('year');

        $("#Id").val(Id);
        $("#University").val(University);
        $("#Desc").val(Desc);
        $("#Year").val(Year);
        $("#Title").val(Title);

        $("#IsActive").prop(
        'checked',
        IsActive === true ||
        IsActive === 'True' ||
        IsActive === 'true'
        );

        });

        $(".btnStatus").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "Do you want to change status?",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });

        $(".btnDelete").click(function () {

        var form = $(this).closest("form");

        Swal.fire({
        title: "Are you sure?",
        text: "You won't be able to revert this!",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#3085d6",
        cancelButtonColor: "#d33",
        confirmButtonText: "Yes, delete it!"
        }).then((result) => {

        if (result.isConfirmed) {
        form.submit();
        }

        });

        });

        });

    </script>
}